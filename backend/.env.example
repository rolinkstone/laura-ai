# ============ Server ============
NODE_ENV=development
PORT=5005

# ============ Database PostgreSQL ============
# PostgreSQL di port default 5432
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bbpom_ai
DB_PASSWORD=isi_password_anda
DB_NAME=bbpom_ai

# ============ Auth / JWT ============
JWT_SECRET=ganti_dengan_secret_yang_kuat
JWT_EXPIRES_IN=1d

# ============ CORS ============
CORS_ORIGIN=http://localhost:3006

# ============ Embedding / RAG ============
EMBEDDING_MODEL=Xenova/multilingual-e5-small
SEARCH_MIN_SCORE=0.15
SEARCH_RESULT_LIMIT=5
# Embedding diproses BERTAHAP. Memori ONNX naik ~ batch × panjang², jadi batch
# besar (mis. seluruh chunk sekaligus) membuat alokasi memori belasan GB dan
# proses Node mati saat upload dokumen besar. 16 aman untuk CPU.
EMBEDDING_BATCH_SIZE=16
# Batas karakter per teks sebelum masuk model (e5 hanya membaca 512 token pertama).
EMBEDDING_MAX_CHARS=2000

# ============ AI / LLM ============
# Provider tunggal: 9Router (AI gateway OpenAI-compatible) — 1 API key untuk semua model.
# Key diambil dari dashboard 9Router (http://localhost:20128).
AI_PROVIDER=ninerouter
NINEROUTER_API_KEY=
# Model Gemini via gateway 9Router (router.bbpompky.id)
NINEROUTER_MODEL=gemini-3.6-flash
NINEROUTER_BASE_URL=https://router.bbpompky.id/v1

# ============ AI Agent (pipeline LAURA) ============
# PLANNER (LLM) -> RAG + WEB SEARCH -> SOURCE SELECTION -> RERANKER -> LLM
# -> jawaban + CITATION/SOURCE.  Lihat docs/agent-pipeline.md
# AGENT_ENABLED=false mengembalikan pipeline RAG legacy.
AGENT_ENABLED=true
AGENT_PLANNER_ENABLED=true
AGENT_RERANK_ENABLED=true
AGENT_RERANK_LLM=true
AGENT_TOP_K=5
AGENT_RAG_CANDIDATES=12
# Dokumen dashboard selalu ikut dicari + jaminan jumlah sumber dokumen di jawaban
AGENT_ALWAYS_USE_RAG=true
AGENT_MIN_RAG_SOURCES=2
AGENT_MIN_RAG_SCORE=0.2
# Kualitas sumber: skor rerank minimum agar sumber dianggap layak (0..1)
AGENT_MIN_TOP_SCORE=0.35
# Naik ke web search otomatis bila sumber RAG lemah (relevansi rendah)
AGENT_ESCALATE_ON_WEAK=true
AGENT_W_VECTOR=0.35
AGENT_W_LEXICAL=0.25
AGENT_W_LLM=0.4
CITATION_ENABLED=true
CITATION_APPEND_LIST=true

# ============ Web Search (situs resmi) ============
AGENT_WEB_SEARCH_ENABLED=true
# auto | tavily | brave | serpapi | duckduckgo | internal | off
WEB_SEARCH_PROVIDER=auto
# true = penyedia memblokir/kosong → otomatis crawl halaman indeks resmi (internal)
WEB_SEARCH_FALLBACK_INTERNAL=true
WEB_SEARCH_OFFICIAL_ONLY=true
WEB_SEARCH_FETCH_TOP=3
# Lingkup pencarian: default hanya keluarga BPOM. Tambah domain lain di sini.
WEB_SEARCH_ALLOWED_DOMAINS=
# true = izinkan SEMUA *.go.id (mis. peraturan.bpk.go.id ikut masuk). Default false.
WEB_SEARCH_ALLOW_GOID_SUFFIX=false
WEB_SEARCH_ALLOWED_SUFFIXES=
WEB_SEARCH_INDEX_URLS=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# ============ Keycloak (SSO) ============
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=laura-ai
# DEV LOKAL boleh pakai client terpisah, mis. local-laura-ai
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# ============ Skrip uji (opsional) ============
# Token JWT untuk skrip uji endpoint admin (testLlmKey.js, testStream.js auth).
# Ambil dari browser setelah login Keycloak:
#   DevTools → Application → Local Storage → key `bbpom_token`
TEST_TOKEN=
# Fallback bila memakai login password lokal (biasanya tidak dipakai lagi)
TEST_USERNAME=
TEST_PASSWORD=
