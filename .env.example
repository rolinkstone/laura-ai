# ============================================================
# TEMPLATE KONFIGURASI DEPLOY — LAURA AI
# ------------------------------------------------------------
# Salin file ini menjadi `.env` lalu isi nilai sebenarnya:
#     cp .env.example .env
#
# File `.env` TIDAK di-commit (lihat .gitignore).
# `docker compose` membaca `.env` ini secara otomatis.
# ============================================================

# ============ Domain publik ============
# Frontend : laura-ai.bbpompky.id
# Backend  : data-laura.bbpompky.id
PUBLIC_FRONTEND_URL=https://laura-ai.bbpompky.id
PUBLIC_BACKEND_URL=https://data-laura.bbpompky.id

# ============ Port di host server ============
# Nginx mem-proxy dari domain di atas ke port ini.
BACKEND_PORT=5005
FRONTEND_PORT=3006
# Backend memakai network_mode: host + listen di loopback (akses via nginx).
# Ubah ke 0.0.0.0 bila backend dipindah ke network bridge.
BACKEND_HOST=127.0.0.1

# ============ PostgreSQL (container yang sudah ada di server) ============
# Container : postgresql_5jhh-postgresql_5JhH-1  (host port 5432)
# Backend berjalan di network host → 127.0.0.1 menunjuk ke server itu sendiri
# dan menjangkau port 5432 yang di-publish container postgres.
#
# Alternatif bila backend dipindah ke network bridge:
#   - publish postgres di semua interface: ports: "5432:5432"
#     lalu set DB_HOST=host.docker.internal, atau
#   - gabungkan ke network Docker postgres & set
#     DB_HOST=postgresql_5jhh-postgresql_5JhH-1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bbpom_ai
DB_PASSWORD=isi_password_postgres
DB_NAME=bbpom_ai

# ============ Auth / JWT (backend) ============
# Buat dengan: openssl rand -base64 48
JWT_SECRET=ganti_dengan_secret_acak_panjang
JWT_EXPIRES_IN=1d

# ============ Keycloak (SSO) ============
# Client ID yang dipakai frontend + backend: laura-ai
# Redirect URI yang harus didaftarkan di client (Valid redirect URIs):
#   https://laura-ai.bbpompky.id/api/auth/callback/keycloak
#   https://laura-ai.bbpompky.id/*
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=laura-ai
KEYCLOAK_CLIENT_SECRET=isi_client_secret_dari_keycloak
# Opsional (hanya untuk admin API / skrip)
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# ============ NextAuth (frontend) ============
# Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET=ganti_dengan_secret_acak_panjang
NEXTAUTH_URL=https://laura-ai.bbpompky.id

# ============ AI / LLM ============
AI_PROVIDER=ninerouter
NINEROUTER_API_KEY=isi_api_key_9router
NINEROUTER_MODEL=gemini-3.6-flash
NINEROUTER_BASE_URL=https://router.bbpompky.id/v1
LLM_MAX_TOKENS=4096

# ============ Embedding / RAG ============
EMBEDDING_MODEL=Xenova/multilingual-e5-small
SEARCH_MIN_SCORE=0.15
SEARCH_RESULT_LIMIT=5

# ============ Web scraper ============
# Biarkan false di produksi.
WEB_ALLOW_INSECURE_TLS=false
