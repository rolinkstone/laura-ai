# ============================================================
# TEMPLATE KONFIGURASI DEPLOY — LAURA AI
# ------------------------------------------------------------
# Salin file ini menjadi `.env` lalu isi nilai sebenarnya:
#     cp .env.example .env
#
# File `.env` TIDAK di-commit (lihat .gitignore).
# `docker compose` membaca `.env` ini secara otomatis.
# ============================================================

# ============ Domain publik ============
# Frontend : laura-ai.bbpompky.id
# Backend  : data-laura.bbpompky.id
PUBLIC_FRONTEND_URL=https://laura-ai.bbpompky.id
PUBLIC_BACKEND_URL=https://data-laura.bbpompky.id

# ============ Port di host server ============
# Nginx mem-proxy dari domain di atas ke port ini.
BACKEND_PORT=5005
FRONTEND_PORT=3006
# 0.0.0.0 karena backend berjalan di network bridge (bukan network_mode: host)
BACKEND_HOST=0.0.0.0

# ============ Network Docker container PostgreSQL ============
# Backend bergabung ke network ini agar bisa memanggil postgres lewat
# NAMA CONTAINER (Docker embedded DNS aktif).
#
# Cara pasti — buat network khusus sekali saja, tanpa perlu menebak nama
# network milik project postgres:
#   docker network create laura-net
#   docker network connect laura-net postgresql_5jhh-postgresql_5JhH-1
#   lalu set POSTGRES_NETWORK=laura-net
#
# Alternatif — pakai network yang sudah ada:
#   docker network ls
#   docker inspect postgresql_5jhh-postgresql_5JhH-1 \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
POSTGRES_NETWORK=nama_network_container_postgres

# ============ PostgreSQL (container yang sudah ada di server) ============
# Nama container — resolveable karena senetwork (POSTGRES_NETWORK di atas).
# ⚠️ Ini hanya berlaku untuk network bridge. Bila backend diubah ke
#    network_mode: host, isi DB_HOST=127.0.0.1 (lihat DEPLOY.md).
#
# ⚠️ Samakan DB_USER / DB_PASSWORD / DB_NAME dengan container tsb.
# ⚠️ Password berisi # $ spasi HARUS dibungkus kutip tunggal:
#    DB_PASSWORD='p@ss#word$123'
DB_HOST=postgresql_5jhh-postgresql_5JhH-1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=isi_password_postgres
DB_NAME=bbpom_ai

# ============ Reverse proxy ============
# 1 = percaya 1 hop proxy (nginx) — agar X-Forwarded-For terbaca rate limiter.
# Isi 0 bila backend tidak di belakang reverse proxy.
TRUST_PROXY=1

# ============ Auth / JWT (backend) ============
# Buat dengan: openssl rand -base64 48
JWT_SECRET=ganti_dengan_secret_acak_panjang
JWT_EXPIRES_IN=1d

# ============ Keycloak (SSO) ============
# Client ID yang dipakai frontend + backend: laura-ai
# Redirect URI yang harus didaftarkan di client (Valid redirect URIs):
#   https://laura-ai.bbpompky.id/api/auth/callback/keycloak
#   https://laura-ai.bbpompky.id/*
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=laura-ai
KEYCLOAK_CLIENT_SECRET=isi_client_secret_dari_keycloak
# Opsional (hanya untuk admin API / skrip)
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# ============ NextAuth (frontend) ============
# Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET=ganti_dengan_secret_acak_panjang
NEXTAUTH_URL=https://laura-ai.bbpompky.id

# ============ AI / LLM ============
AI_PROVIDER=ninerouter
NINEROUTER_API_KEY=isi_api_key_9router
NINEROUTER_MODEL=gemini-3.6-flash
NINEROUTER_BASE_URL=https://router.bbpompky.id/v1
LLM_MAX_TOKENS=4096

# ============ AI Agent (pipeline LAURA) ============
# Alur: PLANNER (LLM) -> RAG + WEB SEARCH -> SOURCE SELECTION -> RERANKER
#       -> LLM -> jawaban + CITATION/SOURCE
# Lihat backend/docs/agent-pipeline.md
AGENT_ENABLED=true
AGENT_PLANNER_ENABLED=true
AGENT_RERANK_ENABLED=true
# Reranker berbasis LLM (matikan bila ingin lebih cepat/murah -> hybrid lexical+vector)
AGENT_RERANK_LLM=true
# Jumlah sumber final yang dikirim ke LLM & ditampilkan sebagai sitasi
AGENT_TOP_K=5
# Kandidat chunk RAG sebelum selection + rerank
AGENT_RAG_CANDIDATES=12
# Dokumen dashboard selalu ikut dicari (walau pertanyaan memuat URL / dirutekan ke web)
AGENT_ALWAYS_USE_RAG=true
# Jawaban akhir selalu memuat minimal N sumber dokumen internal (bila relevan)
AGENT_MIN_RAG_SOURCES=2
AGENT_MIN_RAG_SCORE=0.2
# Kualitas sumber: skor rerank minimum agar sumber dianggap layak (0..1)
AGENT_MIN_TOP_SCORE=0.35
# Naik ke web search otomatis bila sumber RAG lemah
AGENT_ESCALATE_ON_WEAK=true
# Bobot reranker (vector / lexical / llm)
AGENT_W_VECTOR=0.35
AGENT_W_LEXICAL=0.25
AGENT_W_LLM=0.4
# Sitasi bernomor [n] pada jawaban
CITATION_ENABLED=true
CITATION_APPEND_LIST=true

# ============ Web Search (situs resmi) ============
AGENT_WEB_SEARCH_ENABLED=true
# auto = pakai API key yang tersedia, jika tidak ada -> duckduckgo
# Pilihan: auto | tavily | brave | serpapi | duckduckgo | internal | off
# Catatan: DuckDuckGo sering memblokir server (HTTP 202) → hasil kosong.
# Untuk produksi, isi TAVILY_API_KEY (ada paket gratis) atau pakai `internal`.
WEB_SEARCH_PROVIDER=auto
# true = bila penyedia memblokir/mengosongkan hasil, otomatis crawl halaman indeks resmi
WEB_SEARCH_FALLBACK_INTERNAL=true
# true = hanya hasil dari domain resmi (lingkup) yang dipakai
WEB_SEARCH_OFFICIAL_ONLY=true
# Berapa hasil teratas yang kontennya diunduh untuk grounding
WEB_SEARCH_FETCH_TOP=3
WEB_SEARCH_CONTENT_CHARS=2500
# --- Lingkup pencarian (domain yang BOLEH dicari) ---
# Default: hanya keluarga BPOM + domain halaman indeks di WEB_SEARCH_INDEX_URLS.
# Tambahkan domain lain di sini, mis: kemenkes.go.id,halal.go.id
WEB_SEARCH_ALLOWED_DOMAINS=
# true = izinkan SEMUA *.go.id (mis. peraturan.bpk.go.id ikut masuk). Default false.
WEB_SEARCH_ALLOW_GOID_SUFFIX=false
# Suffix domain tambahan (opsional), mis: .gov,.or.id
WEB_SEARCH_ALLOWED_SUFFIXES=
# Halaman indeks yang di-crawl pada mode provider `internal` (opsional)
WEB_SEARCH_INDEX_URLS=
# Kunci penyedia pencarian (opsional — salah satu saja)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# ============ Embedding / RAG ============
EMBEDDING_MODEL=Xenova/multilingual-e5-small
SEARCH_MIN_SCORE=0.15
SEARCH_RESULT_LIMIT=5

# ============ Web scraper ============
# Biarkan false di produksi.
WEB_ALLOW_INSECURE_TLS=false

# ============ Catatan ============
# Seeder TIDAK membuat user admin — login sepenuhnya lewat Keycloak.
# Beri realm role "admin" ke user Keycloak agar dapat akses Admin Console.
