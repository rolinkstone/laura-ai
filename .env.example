# ============================================================
# TEMPLATE KONFIGURASI DEPLOY — LAURA AI
# ------------------------------------------------------------
# Salin file ini menjadi `.env` lalu isi nilai sebenarnya:
#     cp .env.example .env
#
# File `.env` TIDAK di-commit (lihat .gitignore).
# `docker compose` membaca `.env` ini secara otomatis.
# ============================================================

# ============ Domain publik ============
# Frontend : laura-ai.bbpompky.id
# Backend  : data-laura.bbpompky.id
PUBLIC_FRONTEND_URL=https://laura-ai.bbpompky.id
PUBLIC_BACKEND_URL=https://data-laura.bbpompky.id

# ============ Port di host server ============
# Nginx mem-proxy dari domain di atas ke port ini.
BACKEND_PORT=5005
FRONTEND_PORT=3006
# 0.0.0.0 karena backend berjalan di network bridge (bukan network_mode: host)
BACKEND_HOST=0.0.0.0

# ============ Network Docker container PostgreSQL ============
# Backend bergabung ke network ini agar bisa memanggil postgres lewat
# NAMA CONTAINER (Docker embedded DNS aktif).
#
# Cara pasti — buat network khusus sekali saja, tanpa perlu menebak nama
# network milik project postgres:
#   docker network create laura-net
#   docker network connect laura-net postgresql_5jhh-postgresql_5JhH-1
#   lalu set POSTGRES_NETWORK=laura-net
#
# Alternatif — pakai network yang sudah ada:
#   docker network ls
#   docker inspect postgresql_5jhh-postgresql_5JhH-1 \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
POSTGRES_NETWORK=nama_network_container_postgres

# ============ PostgreSQL (container yang sudah ada di server) ============
# Nama container — resolveable karena senetwork (POSTGRES_NETWORK di atas).
# ⚠️ Ini hanya berlaku untuk network bridge. Bila backend diubah ke
#    network_mode: host, isi DB_HOST=127.0.0.1 (lihat DEPLOY.md).
#
# ⚠️ Samakan DB_USER / DB_PASSWORD / DB_NAME dengan container tsb.
# ⚠️ Password berisi # $ spasi HARUS dibungkus kutip tunggal:
#    DB_PASSWORD='p@ss#word$123'
DB_HOST=postgresql_5jhh-postgresql_5JhH-1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=isi_password_postgres
DB_NAME=bbpom_ai

# ============ Reverse proxy ============
# 1 = percaya 1 hop proxy (nginx) — agar X-Forwarded-For terbaca rate limiter.
# Isi 0 bila backend tidak di belakang reverse proxy.
TRUST_PROXY=1

# ============ Auth / JWT (backend) ============
# Buat dengan: openssl rand -base64 48
JWT_SECRET=ganti_dengan_secret_acak_panjang
JWT_EXPIRES_IN=1d

# ============ Keycloak (SSO) ============
# Client ID yang dipakai frontend + backend: laura-ai
# Redirect URI yang harus didaftarkan di client (Valid redirect URIs):
#   https://laura-ai.bbpompky.id/api/auth/callback/keycloak
#   https://laura-ai.bbpompky.id/*
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=laura-ai
KEYCLOAK_CLIENT_SECRET=isi_client_secret_dari_keycloak
# Opsional (hanya untuk admin API / skrip)
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# ============ NextAuth (frontend) ============
# Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET=ganti_dengan_secret_acak_panjang
NEXTAUTH_URL=https://laura-ai.bbpompky.id

# ============ AI / LLM ============
AI_PROVIDER=ninerouter
NINEROUTER_API_KEY=isi_api_key_9router
NINEROUTER_MODEL=gemini-3.6-flash
NINEROUTER_BASE_URL=https://router.bbpompky.id/v1
LLM_MAX_TOKENS=4096

# ============ Embedding / RAG ============
EMBEDDING_MODEL=Xenova/multilingual-e5-small
SEARCH_MIN_SCORE=0.15
SEARCH_RESULT_LIMIT=5

# ============ Web scraper ============
# Biarkan false di produksi.
WEB_ALLOW_INSECURE_TLS=false

# ============ Catatan ============
# Seeder TIDAK membuat user admin — login sepenuhnya lewat Keycloak.
# Beri realm role "admin" ke user Keycloak agar dapat akses Admin Console.
